{
  "schema_version": 1,
  "company_name": "内蒙古九州通医药有限公司",
  "enabled": true,
  "data_types": {
    "配送流向": {
      "fields": {
        "规格": {
          "operation": "direct",
          "source": "规格"
        },
        "流向日期": {
          "operation": "direct",
          "source": "日期"
        },
        "买方-原始简称": {
          "operation": "direct",
          "source": "销往单位"
        },
        "销售数量（盒）": {
          "operation": "direct",
          "source": "数量",
          "transforms": [
            "to_number"
          ]
        },
        "供货单价": {
          "operation": "direct",
          "source": "单价",
          "transforms": [
            "to_number"
          ]
        },
        "批号": {
          "operation": "direct",
          "source": "批号"
        }
      },
      "rules": [],
      "entry_notes": "该商业向是双层的，在原始流向中筛选「公司名称」字段为「内蒙古九州通医药有限公司」，就是一级商的流向，然后在「二级单位名称」中筛选包含“内蒙古药九九-”的行，然后把这段字符串“内蒙古药九九-”删除掉之后，这段就是二级流向的「买方」列，卖方为二级配送商「内蒙古药九九医药科技有限公司」"
    }
  },
  "distribution_chain": {
    "一级配送商业": "公司名称",
    "二级配送商业": "二级单位名称"
  }
}