{
  "schema_version": 1,
  "company_name": "江西汇仁堂药品连锁股份有限公司",
  "enabled": true,
  "data_types": {
    "配送流向": {
      "fields": {
        "规格": {
          "operation": "direct",
          "source": "规格"
        },
        "流向日期": {
          "operation": "direct",
          "source": "日期"
        },
        "买方-原始简称": {
          "operation": "direct",
          "source": "调入门店名称"
        },
        "销售数量（盒）": {
          "operation": "direct",
          "source": "数量",
          "transforms": [
            "to_number"
          ]
        },
        "供货单价": {
          "operation": "direct",
          "source": "含税单价",
          "transforms": [
            "to_number"
          ]
        },
        "批号": {
          "operation": "direct",
          "source": "批号"
        }
      },
      "rules": [],
      "entry_notes": "在原始流向中「数量」字段是要取反的，也就是正数变负数，负数变正数，因为他们的流向结构中的定义就是出库是负数 回库是正数，跟我们正好相反"
    }
  }
}