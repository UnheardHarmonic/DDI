        },
        "买方-原始简称": {
          "operation": "direct",
          "source": "往来单位"
        },
        "品种": {
          "operation": "direct",
          "source": "商品名称"
        },
        "规格": {
          "operation": "direct",
          "source": "商品规格"
        },
        "销售数量（盒）": {
          "operation": "direct",
          "source": "数量",
          "transforms": [
            "to_number"
          ]
        },
        "供货单价": {
          "operation": "direct",
          "source": "含税价",
          "transforms": [
            "to_number"
          ]
        },
        "批号": {
          "operation": "direct",
          "source": "批号"
        }
      },
      "rules": [],
      "entry_notes": "原始导出为标准字段前置+页面原始字段保留双块结构，同名重复列按首个同名列取值"
    }
  }
}