{
  "schema_version": 1,
  "company_name": "包头市仁和堂医药连锁有限公司",
  "enabled": true,
  "data_types": {
    "配送流向": {
      "fields": {
        "规格": {
          "operation": "direct",
          "source": "规格"
        },
        "流向日期": {
          "operation": "direct",
          "source": "业务日期"
        },
        "买方-原始简称": {
          "operation": "direct",
          "source": "单位名称"
        },
        "销售数量（盒）": {
          "operation": "difference",
          "positive_sources": [
            "出库数量"
          ],
          "negative_sources": [
            "入库数量"
          ]
        },
        "批号": {
          "operation": "direct",
          "source": "批号"
        }
      },
      "rules": [],
      "entry_notes": "这家的「销售数量（盒）」需要 2 个字段合在一起才是完整的，其一「入库数量」* -1  因为入库实际就是退回 只不过他用正数体现的 需要改为负数，另一个就是「出库数量」"
    }
  }
}