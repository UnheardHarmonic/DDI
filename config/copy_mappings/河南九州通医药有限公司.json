            "to_number"
          ]
        },
        "供货单价": {
          "operation": "direct",
          "source": "单价",
          "transforms": [
            "to_number"
          ]
        },
        "批号": {
          "operation": "direct",
          "source": "批号"
        }
      },
      "rules": [],
      "entry_notes": "九州通的流向是双层的，在原始字段「公司名称」中，值为「河南九州通医药有限公司」的行就是一级配送商的流向，而其他的都是二级配送商的流向"
    }
